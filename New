void game()
{


    int c = 0;
    int carti[200][200];
    memset(carti,0, sizeof(carti));
    // sunt 13 nr de carti si 4 culori
    // in total 52 de carti

// de optimizat mai tarziu valorile din vectori

    int culori = 4, nrc = 13;



    int nl = 1;
    last[nl] = 0;

    bool aranjmasa = false;

    int auxval, auxcul;

    srand(time(0));



    for (int i = 1; i <= culori; i++)
        for (int j = 1; j <= nrc; j++)
        {
            auxval = rand() % 13 + 2; //valoarea cartii
            auxcul = rand() % 4 + 1;        // culoarea
            while (carti[auxval][auxcul] || auxval == 11)
            {
                auxval = rand() % 14 + 1;
                auxcul = rand() % 4 + 1;
            }
            carti[auxval][auxcul] = 1;
            // am generat cartile
            //trebuie aranjate pe masa

            if (!aranjmasa)
            {

                last[nl]++;
                masa[last[nl]][nl].val = auxval;
                masa[last[nl]][nl].cul = auxcul;
            }
            // c++; cout << "debug " << c  << endl;

            // ma ajuta sa pun cartile pe masa
            if (last[nl] < 7)
            {
                if (nl == last[nl])
                {
                    nl++;
                    last[nl] = 0;
                }

            }
            else aranjmasa = true;
            // si am pus cartile pe masa

            if (aranjmasa)
            {

                ndeck++;
                deck[ndeck].val = auxval;
                deck[ndeck].cul = auxcul;
            }

        }

    for (int i = 1; i <= 7; i++)
        masa[i][i].descoperita = true;

}

bool acceptat(int valx ,int valy, int culx, int culy)
{
    if(culx%2!=culy%2)
    {
        if(valx == valy+1)
            return true;
        if(valx ==12 && valy ==10)
            return true;
    }
    if(valx == 0 && valy ==14)
        return true;
     return false;
}


void comanda(int com)
{
    if(!ingame)
    {
        if (com == 1)
        {
            system("CLS");
            cout << "h  -  commands to play" << endl;
            cout << "s -  starts the game " << endl;
            cout << "d - draw a card " << endl;
            com = citire();
            comanda(com);
        }
        else if (com == 2)
        {
            ingame = true;
            game();
            while (!castigat || !pierdut)
            {
                afisare();
                com = citire();
                comanda(com);
            }
        }
        else
        {
            com = citire();
            comanda(com);
        }
    }

    else
    {
        if (com == 1)
        {
            cout << "h  -  commands to play" << endl;
            cout << "s -  starts the game " << endl;
        }
        else if (com == 3)
        {

            if (nshown > 0)
            {
                nshown--;
            }
            else if (nshown == 0)
            {
                nshown = ndeck;
            }

        }
        else if (com == 4)
        {
            int va;
            char xi,c;
            cout << endl << " scrie valoarea si coloana la ce muti" << endl;
            cin >> va >> c;   // poz y si valoare pe care o muti
            cout << endl << " scrie coloana unde doresti sa muti" << endl;
            cin >> xi;
            if(c=='d')
            {
               int i=xi-'0';
                if(masa[last[i]][i].descoperita && acceptat(masa[last[i]][i].val,deck[nshown].val,masa[last[i]][i].cul,deck[nshown].cul))
                {
                    last[i]++;
                    aux = deck[nshown];
                    deck[nshown] = masa[last[i]][i];
                    masa[last[i]][i] = aux;
                    masa[last[i]][i].descoperita=true;
                    for(int j=nshown; j<ndeck; j++)
                    {
                        deck[j].cul=deck[j+1].cul;
                        deck[j].val=deck[j+1].val;
                    }
                    ndeck--;
                }
            }
            else
            {
                int i=xi-'0';
                int y=c-'0';
                for (int k = 1; k <= last[y]; k++)
                {
                    if (masa[k][y].val == va && masa[k][y].descoperita && masa[last[i]][i].descoperita && acceptat(masa[last[i]][i].val,masa[k][y].val,masa[last[i]][i].cul,masa[k][y].cul))
                    {
                        if (masa[k - 1][y].descoperita == false)
                            masa[k - 1][y].descoperita = true;
                        int n = last[y];
                        for (k; k <= n; k++)
                        {
                            last[y]--;
                            last[i]++;
                            aux = masa[k][y];
                            masa[k][y] = masa[last[i]][i];
                            masa[last[i]][i] = aux;

                        }

                    }

                }

            }
        }

    }

}


