struct carti{

	int val;
	int cul;
	bool desc;

}carti[60], neut;

HANDLE hConsole = GetStdHandle(STD_OUTPUT_HANDLE);
struct carti* masa[40][40], c;

int x, y, ndeck, last[8], nshown;


void generare()
{
	//memset(*masa, 0,sizeof(*masa));
	int frecventa[60],a=0;
	memset(frecventa, 0, sizeof(frecventa));

	int ran;
	srand(time(0));

	neut.val = 0;
	neut.cul = 0;
	neut.desc = false;

	//pt elementul gol

	for (int i = 0; i <= 30; i++)
		for (int j = 0; j <= 30; j++)
			masa[i][j] = &neut;

	for (int i = 1; i <= 7; i++)
		last[i] = i;

	for (int i = 1; i <= 52; i++) //punem valorile si culorile la carti
	{
		carti[i].val = i % 13 + 1;
		carti[i].cul = i % 4 + 1;
	}
	
	for(x=1;x<=7;x++)
		for (y = x; y <= 7; y++)
		{
			ran = rand() % 52 + 1;
			while(frecventa[ran])
			{
				ran = rand() % 52 + 1; // le generez ce carti atribui
			}
			a++;
			masa[x][y] = &carti[ran];
			frecventa[ran] = 1;

			if (x == y)
			{
				(*masa[x][y]).desc = true; //le descopar pe ultimele din linie
			}
				
		}

	ndeck = 52 - a;
	y = 0;

	for (x = 1; x <=ndeck ; x++)
	{

		ran = rand() % 52 + 1;
		while (frecventa[ran])
		{
			ran = rand() % 52 + 1;
		}
		masa[x][y] = &carti[ran]; //std::cout << std::endl << (*masa[x][y]).val;
		frecventa[ran] = 1;
		(*masa[x][y]).desc = true;
	}
	nshown = ndeck; // de schimbat la ndeck + 1
}

void culoare(int cul)
{
	if (cul == 1)
	{
		SetConsoleTextAttribute(hConsole, 4);//rosu
	}
	if (cul == 2)
	{
		SetConsoleTextAttribute(hConsole, 8);//negru
	}
	if (cul == 3)
	{
		SetConsoleTextAttribute(hConsole, 5);//carou
	}
	if (cul == 4)
	{
		SetConsoleTextAttribute(hConsole, 7);//trifoi
	}


}

void afisCor(int x)
{
	if (x == 11)
		std::cout << std::setw(3) << "J";
	else if (x == 12)
		std::cout << std::setw(3) << "Q";
	else if (x == 13)
		std::cout << std::setw(3) << "K";
	else if (x == 1)
		std::cout << std::setw(3) << "A";
	else 
		std::cout << std::setw(3) << x;
}

void afisPuse()
{
	SetConsoleTextAttribute(hConsole, 4);
	std::cout << std::setw(3) <<  "#";
	SetConsoleTextAttribute(hConsole, 8);
	std::cout << std::setw(3) << "#";
	SetConsoleTextAttribute(hConsole, 5);
	std::cout << std::setw(3) << "#";
	SetConsoleTextAttribute(hConsole, 7);
	std::cout << std::setw(3) << "#";

}

void afisare()
{
	SetConsoleTextAttribute(hConsole, 1);//albastru
	if (nshown != 0)
		std::cout << std::setw(3) << "X";
	else std::cout << std::setw(3) << " ";

	if ((*masa[nshown][0]).val)
	{
		culoare((*masa[nshown][0]).cul);
		afisCor((*masa[nshown][0]).val);
	}
	else
	{
		std::cout << std::setw(3) << " ";
	}

	afisPuse();

	std::cout << std::endl << std::endl;




	int boardsize = 20;
	for (x = 1; x <= boardsize; x++)
	{
		for (y = 1; y <= 7; y++)
		{
			if (!(*masa[x][y]).desc && (*masa[x][y]).val > 0)
			{
				SetConsoleTextAttribute(hConsole, 1);
				std::cout << std::setw(3) << "X";
			}
			else if ((*masa[x][y]).val>0 )
			{
				culoare((*masa[x][y]).cul);
				afisCor((*masa[x][y]).val);
			}
			else
			{
				std::cout << std::setw(3) << " ";
			}
		}
		std::cout << std::endl;
	}
}

int main()
{
	generare();
	afisare();
}

