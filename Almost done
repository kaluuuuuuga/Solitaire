int cond()
{
	//daca culoarea si valoarea corespund
	if (((*masa[xm][ym]).cul % 2 != (*masa[xc][yc]).cul % 2) && ((*masa[xm][ym]).val + 1 == (*masa[xc][yc]).val))
	{
		if (yc != ym)
		{
			return 1;
		}
			
	}
		

	return 0;


}

void cursor(int offsetx, int offsety)
{
	if ((*masa[offsetx + xc][offsety + yc]).desc)
	{
		xc += offsetx;
		yc += offsety;
	}
	else //mutare din coloana pe coloana
	{ 
		xc = last[yc + offsety];
		yc = yc + offsety;
		//std::cout << xc << " " << yc;
	}

}

void draw()
{
	if (nshown > 1)
	{
		nshown--;
		if (xc==nshown+1 && yc==0)
		{
			xc = nshown;
			cursor(0, 0);
		}
		if (xm == nshown + 1 && ym == 0)
		{
			xm = -1;
			ym = -1;
			mut = false;
		}
		while ((*masa[nshown][0]).val == 0)
		{
			nshown--;
			if (xc == nshown + 1 && yc == 0)
			{
				xc = nshown;
				cursor(0, 0);
			}
		}
		
	}
	else if (nshown == 1)
	{
		if (yc == 0)
		{
			xc = 2;
			yc = 2;
			cursor(0, 0);
		}
		nshown = ndeck + 1;
	
	}

	
}

void mutare()
{
 if(yc!=0)
	if (xm < last[ym]) //if(cond())
	{
		if(xm > 0)
		if ((*masa[xm - 1][ym]).val > 0)
			(*masa[xm - 1][ym]).desc = true;

		int p = last[ym]; int z = xc;
		for (int i = xm; i<=p; i++)
		{
			last[ym]--;
			last[yc]++;
			
			c = masa[i][ym]; 
			masa[i][ym] = masa[z+1][yc];
			masa[z+1][yc] = c;
			z++;
		}
		mut = false;
	}
	else	 //if (cond())
	{
		last[ym]--;
		last[yc]++;
		if ((*masa[xm - 1][ym]).val > 0)
			(*masa[xm - 1][ym]).desc = true;

		c = masa[xm][ym]; // c primeste pointer-ul memorat in vectorul masa
		masa[xm][ym] = masa[xc + 1][yc];
		masa[xc + 1][yc] = c;
		mut = false;
	}

	if (ym == 0)
	{
		for (int x = nshown; x <= ndeck; x++)
		{
			masa[x][0] = masa[x + 1][0];
		}
		masa[ndeck + 1][0] = &neut;
		ndeck--;
		nshown--;
    }
	xm = -1; ym = -1;
}



void ifMoving()
{

	if (xm==xc && ym==yc)
	{
		mut = false;
		xm = -1;
		ym = -1;
	}
	else if (!(xm==xc && ym==yc))
	{
		if (!mut && (*masa[xc][yc]).val > 0)
		{
			mut = true;
			xm = xc;
			ym = yc;
		}
		else
		{
			mutare();
		}
		
	}
			

}

void laStanga()
{
	if (yc == 8)
	{
		yc = 0;
		xc = nshown;
	}
	else if (yc > 8)
	{
		yc--;
		xc = pus[yc - 7];
	}

}

void laDreapta()
{
	if (yc == 0)
	{
		yc = 8;		
	}
	else if(yc<11)
	{
		yc++;
	}
	xc = pus[yc - 7];
}

void action(int c)
{
	if (c == 100)
	{
		draw();
	}
	else if (c == 109)
	{
		ifMoving();
	}
	else if (c == 72)
	{
		if (xc > 0 && yc <= 3 && nshown != ndeck+1 && ndeck > 0) // mutare pe deck
		{
			if (!(*masa[xc - 1][yc]).desc)
			{
				yc = 0; xc = nshown;
			}

		}
		else if (xc == 0 && nshown != ndeck + 1) // pt atunci cand e spatiu gol
		{
			yc = 0; xc = nshown;
		}
		else if (xc > 0 && yc > 3)
		{
			if (!(*masa[xc - 1][yc]).desc)
			{
				yc = yc+4; xc = pus[yc];
			}
		}
		else if (xc == 0 && yc > 3)
		{
			yc = yc+4; xc = pus[yc];
		}

		if(xc>=2 && yc!=0)
		cursor(-1,0);
		
		
	}
	else if (c == 80)
	{
		if (xc < 16 && yc!=0)
		cursor(1,0);

		if (yc == 0)
		{
			if ((*masa[1][3]).desc)
			{
				xc = 1;
				yc = 3;
			}
			else
			{
				yc = 3;
				xc = last[yc];
			}			
		}
		if (yc >= 8)
		{
			xc = last[yc-4];
			yc -= 4;
		}
	}
	else if (c == 75)
	{
		if (yc > 1 && yc < 8)
		cursor(0,-1);
		else laStanga();
	}
	else if (c == 77)
	{
		if (yc < 7 && yc != 0)
			cursor(0, 1);
		else if(yc!= 7 ) laDreapta();
	}

}

