void afisCor(int x)
{
	if (x == 11)
		std::cout << std::setw(3) << "J";
	else if (x == 12)
		std::cout << std::setw(3) << "Q";
	else if (x == 13)
		std::cout << std::setw(3) << "K";
	else if (x == 1)
		std::cout << std::setw(3) << "A";
	else 
		std::cout << std::setw(3) << x;
}

