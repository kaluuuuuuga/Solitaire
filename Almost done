void game()
{
	while (!win || !lose)
	{
		system("cls"); // "clear" for unix-like systems
		afisare();
		std::cout << xc << " " << yc;
		int c = _getch();
		action(c);
		//std::cout << c;
	}	
}



int main()
{
	generare();
	game();
}

