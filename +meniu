int condP()
{	//nush daca e bine xm==last[ym]
	if ( ((*masa[xm][ym]).val == (*masa[xc][yc]).val + 1 ) && ((*masa[xm][ym]).cul == yc-7) && yc>=8 && (xm==last[ym]|| ym==0) )
	{
		return 1;
	}

	return 0;
}

int cond()
{
	//daca culoarea si valoarea corespund
	if ( (((*masa[xm][ym]).cul % 2 != (*masa[xc][yc]).cul % 2) && ((*masa[xm][ym]).val + 1 == (*masa[xc][yc]).val)) || ((*masa[xm][ym]).val == 13 && (*masa[xc][yc]).cul == 0) && yc<8)
	{
			return 1;		
	}
		

	return 0;
}

void cursor(int offsetx, int offsety)
{
	if ((*masa[offsetx + xc][offsety + yc]).desc)
	{
		xc += offsetx;
		yc += offsety;
	}
	else //mutare din coloana pe coloana
	{ 
		xc = last[yc + offsety];
		yc = yc + offsety;
	}

}

void draw()
{
	if (nshown > 1)
	{
		nshown--;
		if (xc==nshown+1 && yc==0)
		{
			xc = nshown;
			cursor(0, 0);
		}
		if (xm == nshown + 1 && ym == 0) //anuleaza mutarea daca dai draw
		{
			xm = -1;
			ym = -1;
			mut = false;
		}
	}
	else if (nshown == 1)
	{
		if (yc == 0)
		{
			yc = 8;
			xc = last[yc];
			cursor(0, 0);
		}
		nshown = ndeck + 1;
	
	}

	
}
void mutare()
{
	if (yc != 0)
		if (xm < last[ym] && yc<=7)
		{
			if (xm > 0)
				if ((*masa[xm - 1][ym]).val > 0)
					(*masa[xm - 1][ym]).desc = true;

			int p = last[ym]; int z = xc;
			for (int i = xm; i <= p; i++)
			{
				last[ym]--;
				last[yc]++;

				c = masa[i][ym];
				masa[i][ym] = masa[z + 1][yc];
				masa[z + 1][yc] = c;
				z++;
			}
			mut = false;
		}
		else
		{
			last[ym]--;
			last[yc]++;
			if ((*masa[xm - 1][ym]).val > 0)
				(*masa[xm - 1][ym]).desc = true;

			c = masa[xm][ym]; // c primeste pointer-ul memorat in vectorul masa
			masa[xm][ym] = masa[xc + 1][yc];
			masa[xc + 1][yc] = c;
			mut = false;
			
			if (yc > 7 && yc <= 11)
			{
				xc = last[yc];
			}
		}

	if (ym == 0)
	{
		for (int x = nshown; x <= ndeck; x++)
		{
			masa[x][0] = masa[x + 1][0];
		}
		masa[ndeck + 1][0] = &neut;
		ndeck--;
	}
	xm = -1; ym = -1;

	if ((*masa[last[8]][8]).val == (*masa[last[9]][9]).val==(*masa[last[10]][10]).val == (*masa[last[11]][11]).val==13)
	{
		win = true;
	}
}

void ifMoving()
{
	//daca cursorul se afla pe aceeasi pozitie cu mutarea se anuleaza mutarea
	// altfel daca nu este initiata deja mutarea si valoarea mutata este mai mare ca 0 se initiaza
	//altfel se verifica conditiile de mutare
	if (xm==xc && ym==yc)
	{
		mut = false;
		xm = -1;
		ym = -1;
	}
	else
	{
		if (!mut && !(xc == 0 && yc >= 8))
		{
			if ((*masa[xc][yc]).val > 0)
			{
				mut = true;
				xm = xc;
				ym = yc;
			}
			
		}
		else if(mut)
		{
			if (condP() || cond())
				mutare();
		}
		
		
	}
			

}
void laDreapta()
{
	if (yc == 0)
	{
		yc = 8;	
		xc = last[yc];
	}
	else if(yc<11)
	{
		yc++;
		xc = last[yc];
	}
	
}

void action(int c)
{
	if (c == 100)
	{
		draw();
	}
	else if (c == 109)
	{
		ifMoving();
	}
	else if (c == 72)
	{
		if (xc > 0 && yc <= 3 && nshown != ndeck+1 && ndeck > 0) // mutare pe deck
		{
			if (!(*masa[xc - 1][yc]).desc)
			{
				yc = 0; xc = nshown;
			}

		}
		else if (xc == 0 && nshown != ndeck + 1 && yc<=3) // pt atunci cand e spatiu gol
		{
			yc = 0; xc = nshown;
		}
		else if (xc > 0 && yc > 3 && yc<=7)
		{
			if (!(*masa[xc - 1][yc]).desc)
			{
				yc += 4; xc = last[yc];
			}
		}
		else if (xc == 0 && yc > 3 && yc<=7)
		{
			yc += 4; xc = last[yc];
		}

		if (xc >= 2 && yc != 0 && yc<=7)
			cursor(-1, 0);
		
	}
	else if (c == 80)
	{
		if (xc < 16 && yc!=0)
		cursor(1,0);

		if (yc == 0)
		{
			if ((*masa[1][3]).desc)
			{
				xc = 1;
				yc = 3;
			}
			else
			{
				yc = 3;
				xc = last[yc];
			}			
		}
		if (yc >= 8)
		{
			yc -= 4;
			xc = last[yc];
			
		}
	}
	else if (c == 75)
	{
		

		if (yc > 1 && yc < 8)
		{
			if ((*masa[xc + 1][yc - 1]).desc == true && xc == 0)
				cursor(1, -1);
			else 
			cursor(0, -1);
		}
		else if (yc == 8 && nshown!=ndeck+1)
		{
			yc = 0;
			xc = nshown;
		}
		else if (yc > 8)
		{
			yc--;
			xc = last[yc];
		}
	}
	else if (c == 77)
	{
		if (yc < 7 && yc != 0)
			cursor(0, 1);
		else if (yc == 0)
		{
			yc = 8;
			xc = last[yc];
		}
		else if (yc < 11)
		{
			yc++;
			xc = last[yc];
		}
	}

}

