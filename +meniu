struct carti{

	int val;
	int cul;
	bool desc;
}carti[60], neut;

HANDLE hConsole = GetStdHandle(STD_OUTPUT_HANDLE);


struct carti *masa[40][40], *c;

int x, y, ndeck, last[12], nshown;

bool win = false, lose = false, mut=false;
int xc = 1, yc = 1, xm = -1, ym= -1;

void generare()
{
	//memset(*masa, 0,sizeof(*masa));
	int frecventa[60],a=0;
	memset(frecventa, 0, sizeof(frecventa));

	int ran;
	srand(time(0));

		neut.val = 0;
		neut.cul = 0;
		neut.desc = false;
	

	//pt elementul gol

	for (int i = 0; i <= 25; i++)  /// De ce nu trebuie sa fie mai mare decat 25???
		for (int j = 0; j <= 11; j++)
			masa[i][j] = &neut;

	for (int i = 1; i <= 7; i++)
		last[i] = i;

	for (int i = 1; i <= 52; i++) //punem valorile si culorile la carti
	{
		carti[i].val = i % 13 + 1;
		carti[i].cul = i % 4 + 1;
	}
	
	for(x=1;x<=7;x++)
		for (y = x; y <= 7; y++)
		{
			ran = rand() % 52 + 1;
			while(frecventa[ran])
			{
				ran = rand() % 52 + 1; // le generez ce carti atribui
			}
			a++;
			masa[x][y] = &carti[ran];
			frecventa[ran] = 1;

			if (x == y)
			{
				(*masa[x][y]).desc = true; //le descopar pe ultimele din linie
			}
				
		}

	for (int i = 8; i <= 11; i++)
	{
		last[i] = 0;
	}
	
	
		

	ndeck = 52 - a;
	y = 0;


	for (x = 1; x <=ndeck ; x++)
	{

		ran = rand() % 52 + 1;
		while (frecventa[ran])
		{
			ran = rand() % 52 + 1;
		}
		masa[x][y] = &carti[ran]; //std::cout << std::endl << (*masa[x][y]).val;
		frecventa[ran] = 1;
		(*masa[x][y]).desc = true;
	}
	masa[0][0] = &neut;

	nshown = ndeck+1;

	win = false;
	lose = false;

	xc = 1; yc = 1;
}

